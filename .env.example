# Copy to .env and replace the placeholders. Never commit .env.
# ASP.NET Core reads these as environment variables ("__" maps to ":").
# Keep values quoted so the file can be loaded with: set -a; source .env; set +a

ConnectionStrings__DefaultConnection="<postgres-connection-string>"

# RabbitMQ via MassTransit. When disabled, no broker connection is made.
RabbitMq__Enabled=false
RabbitMq__Host="localhost"
RabbitMq__Port=5672
RabbitMq__VirtualHost="/"
RabbitMq__Username="<rabbitmq-username>"
RabbitMq__Password="<rabbitmq-password>"

# MassTransit is pinned to the 8.x line (Apache-2.0); no license key is needed.

# SMTP for verification email delivery. Real values are never committed.
Email__Enabled=false
Email__Smtp__Host="<smtp-host>"
Email__Smtp__Port=587
Email__Smtp__UseSsl=true
Email__Smtp__Username="<smtp-username>"
Email__Smtp__Password="<smtp-password>"
Email__Smtp__FromAddress="<smtp-from-address>"
Email__Smtp__FromName="Smart Solar"

# Frontend link used to build the verification URL.
Frontend__EmailVerificationUrl="http://localhost:3000/verify-email"

# Local mail catchers only (Mailpit/MailHog). Leave false everywhere else:
# when true the SMTP session may be unencrypted.
Email__Smtp__AllowInsecureTransport=false

# Certificate revocation checking for SMTP. True is hard-fail: if the CA's
# CRL/OCSP endpoint is unreachable the handshake fails. Setting false removes
# the revocation check entirely (no soft-fail option), so a revoked but
# unexpired certificate would be accepted; chain, trust, expiry and hostname
# validation and TLS encryption still apply.
Email__Smtp__CheckCertificateRevocation=true

# JWT access tokens. The signing key is a secret: generate one per environment
# (at least 32 bytes) and never commit it.
Jwt__Issuer="SmartSolar"
Jwt__Audience="SmartSolarClients"
Jwt__SigningKey="<jwt-signing-key-min-32-bytes>"
Jwt__AccessTokenLifetimeMinutes=15

# Refresh token and password reset lifetimes.
Auth__RefreshToken__LifetimeDays=14
Auth__PasswordReset__LifetimeMinutes=60

# Frontend link used to build the password reset URL.
Frontend__PasswordResetUrl="http://localhost:3000/reset-password"

# Optional page for admin-provisioned accounts to set their first password.
# Empty = the password reset page (the reset endpoint also accepts account-setup tokens).
Frontend__AccountSetupUrl=

Redis__Enabled=false
Redis__ConnectionString="localhost:6379"
Redis__InstanceName="SmartSolar:"

# ---------------------------------------------------------------------------
# Installation Flow (on-site survey → quotation → contract → PayOS → installation) and the
# knowledge base (RAG chatbot). Keep both false until the PENDING_MANUAL_MIGRATION in
# guides/sql/installation-workflow-and-knowledge-base-schema-review.sql has been reviewed and applied.
# ---------------------------------------------------------------------------
Features__InstallationWorkflowEnabled=true
Features__KnowledgeBaseEnabled=true
# Deprecated: Features__Flow2Enabled is still honoured for both features when the two keys above
# are absent (a startup warning is logged). Do not set it in new environments.

# S3 object references. The API signs short-lived PUT URLs (POST /api/files/presigned-upload), the frontend
# uploads the bytes straight to S3, and the API verifies the object (HEAD + bounded GET) before use.
# Prefer an IAM role / instance profile; static keys are optional and belong only in .env. The credential
# needs s3:PutObject (uploads) and s3:GetObject + s3:GetObjectVersion (verification and read URLs) on the
# bucket's upload prefixes. The bucket stays private (no public ACL); it needs a CORS rule for the FE origin.
# See guides/file-upload-api-integration.md.
Storage__DefaultBucket=
Storage__AllowedBuckets=
Storage__S3__Enabled=false
Storage__S3__Region="ap-southeast-1"
Storage__S3__AccessKeyId=
Storage__S3__SecretAccessKey=
# Bucket versioning must be enabled: verified files are pinned to their S3 version id.
# Set false only for stores without versioning (an upload to the same key could then replace a file).
Storage__S3__RequireObjectVersioning=true
# Photos are served through short-lived presigned GET URLs issued after authorization (the bucket stays
# private); upload PUT URLs use the same lifetime. Seconds, 30-3600 (startup fails outside the range).
Storage__S3__PresignedUrlTtlSeconds=300
# HEAD the pinned object version before signing (a deleted object answers 410 instead of a broken URL).
Storage__S3__VerifyObjectBeforeSigning=true

# Solar simulation results are temporary: full results live in the distributed cache (Redis, or the
# in-process memory cache when Redis__Enabled=false — single instance only) for ResultTtlMinutes.
# Only the selected simulation's compact summary is stored in PostgreSQL. Optionally a durable full
# snapshot of the selected simulation is written to S3 (SHA-256 verified on read). Snapshot uploads
# use the default AWS credential chain (IAM role) or the optional Storage__S3__ static keys above.
SolarSimulation__ResultTtlMinutes=1440
SolarSimulation__Snapshots__Enabled=false
SolarSimulation__Snapshots__Bucket=
SolarSimulation__Snapshots__Region="ap-southeast-1"

# PayOS (single 100% payment). Credentials are secrets: never commit them.
Providers__PayOS__Enabled=false
Providers__PayOS__ClientId=
Providers__PayOS__ApiKey=
Providers__PayOS__ChecksumKey=
Payments__ReturnUrl="http://localhost:5173/payments/return"
Payments__CancelUrl="http://localhost:5173/payments/cancel"

# Internal RAG service (FastAPI). Same shared secret on both sides, >= 32 chars,
# e.g. `openssl rand -hex 32`. The service is never published on a public port.
Rag__Enabled=false
Rag__ServiceBaseUrl="http://rag-service:8000"
Rag__ServiceSharedSecret="<rag-shared-secret-min-32-chars>"

# RAG service container (read by docker compose → rag-service).
RAG_IMAGE=hoaikhoitran/smartsolar-rag-service
RAG_IMAGE_TAG=latest
RAG_ENV=development
RAG_SHARED_SECRET="<rag-shared-secret-min-32-chars>"
# pgvector (production) or memory (local only). The knowledge_chunk table is a
# PENDING_MANUAL_MIGRATION: src/SmartSolar.RagService/sql/knowledge_chunk.sql
RAG_VECTOR_STORE=memory
RAG_DATABASE_URL=
RAG_STORAGE=s3
RAG_S3_REGION="ap-southeast-1"
RAG_S3_ALLOWED_BUCKETS=
# Embeddings (knowledge_chunk.embedding is vector(1536)): OpenAI text-embedding-3-small, 1536 dimensions.
# The service refuses any other model/dimension. Put the real key only in .env (never commit it).
# Offline local development only: RAG_EMBEDDING_PROVIDER=hashing (model and base URL left empty);
# it is refused unless RAG_ENV=development or test, and its vectors are never mixed with real ones.
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSION=1536
RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
RAG_EMBEDDING_API_KEY=
# LLM: "extractive" is an offline development stand-in; for real answers use an OpenAI-compatible
# endpoint (keys only in .env).
RAG_LLM_PROVIDER=extractive
RAG_LLM_MODEL=extractive-dev
RAG_LLM_BASE_URL=
RAG_LLM_API_KEY=
# Optional comma list of generation models the API's admin configuration may select (empty = any valid id).
# Keep it a superset of Rag:GenerationModels.
RAG_LLM_ALLOWED_MODELS=
# Default prompt template when a request names none (templates live in app/prompting.py).
RAG_PROMPT_VERSION=v1
# Defaults when a request sends no chunk settings; keep equal to Rag__ChunkCharacters / Rag__ChunkOverlap.
RAG_CHUNK_CHARACTERS=2400
RAG_CHUNK_OVERLAP=300
# Optional static S3 read credentials for the RAG service (prefer an IAM role).
RAG_AWS_ACCESS_KEY_ID=
RAG_AWS_SECRET_ACCESS_KEY=
# >1 only with RAG_VECTOR_STORE=pgvector.
RAG_WORKERS=1
# Must stay below Rag__IngestTimeoutSeconds (default 300) so the service stops before the API gives up.
RAG_INGEST_DEADLINE_SECONDS=270
