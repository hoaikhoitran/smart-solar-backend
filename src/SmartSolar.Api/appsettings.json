{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "SmartSolar",
    "Audience": "SmartSolarClients",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15
  },
  "Auth": {
    "EmailVerification": {
      "LifetimeMinutes": 1440
    },
    "RefreshToken": {
      "LifetimeDays": 14
    },
    "PasswordReset": {
      "LifetimeMinutes": 60
    }
  },
  "Frontend": {
    "EmailVerificationUrl": "",
    "PasswordResetUrl": ""
  },
  "RateLimiting": {
    "Register": {
      "PermitLimit": 5,
      "WindowMinutes": 10
    },
    "VerifyEmail": {
      "PermitLimit": 20,
      "WindowMinutes": 10
    },
    "ResendVerification": {
      "PermitLimit": 3,
      "WindowMinutes": 15
    },
    "Login": {
      "PermitLimit": 10,
      "WindowMinutes": 10
    },
    "Refresh": {
      "PermitLimit": 30,
      "WindowMinutes": 10
    },
    "ForgotPassword": {
      "PermitLimit": 3,
      "WindowMinutes": 15
    },
    "ResetPassword": {
      "PermitLimit": 10,
      "WindowMinutes": 15
    },
    "ChangePassword": {
      "PermitLimit": 10,
      "WindowMinutes": 15
    },
    "CatalogRead": {
      "PermitLimit": 60,
      "WindowMinutes": 1
    },
    "CatalogWrite": {
      "PermitLimit": 30,
      "WindowMinutes": 1
    },
    "SimulationWrite": {
      "PermitLimit": 10,
      "WindowMinutes": 1
    }
  },
  "Email": {
    "Enabled": false,
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "CheckCertificateRevocation": true,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "Smart Solar",
      "AllowInsecureTransport": false
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Cors": {
  "AllowedOrigins": []
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379",
    "InstanceName": "SmartSolar:"
  },
  "SolarSimulation": {
    "PreliminaryDefaults": {
      "PanelGapMm": 20,
      "FlushRowGapMm": 20,
      "RackRowGapFallbackMm": 1000,
      "EdgeSetbackMm": 300,
      "ObstacleClearanceMm": 300,
      "RackLowEdgeClearanceMm": 200,
      "ModuleThicknessMm": 40
    },
    "Limits": {
      "MaxSurfaceSideM": 200,
      "MaxPlacements": 5000,
      "MaxObstacles": 50
    },
    "DefaultSystemLossPercent": 14,
    "ProviderBudgetSeconds": 25
  },
  "Providers": {
    "Pvgis": {
      "BaseUrl": "https://re.jrc.ec.europa.eu/api/v5_3/"
    },
    "NasaPower": {
      "BaseUrl": "https://power.larc.nasa.gov/api/temporal/climatology/point",
      "StartYear": 2001,
      "EndYear": 2020
    }
  }
}
