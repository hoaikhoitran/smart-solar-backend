{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "SmartSolar",
    "Audience": "SmartSolarClients",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15
  },
  "Auth": {
    "EmailVerification": {
      "LifetimeMinutes": 1440
    },
    "RefreshToken": {
      "LifetimeDays": 14
    },
    "PasswordReset": {
      "LifetimeMinutes": 60
    }
  },
  "Frontend": {
    "EmailVerificationUrl": "",
    "PasswordResetUrl": ""
  },
  "RateLimiting": {
    "Register": {
      "PermitLimit": 5,
      "WindowMinutes": 10
    },
    "VerifyEmail": {
      "PermitLimit": 20,
      "WindowMinutes": 10
    },
    "ResendVerification": {
      "PermitLimit": 3,
      "WindowMinutes": 15
    },
    "Login": {
      "PermitLimit": 10,
      "WindowMinutes": 10
    },
    "Refresh": {
      "PermitLimit": 30,
      "WindowMinutes": 10
    },
    "ForgotPassword": {
      "PermitLimit": 3,
      "WindowMinutes": 15
    },
    "ResetPassword": {
      "PermitLimit": 10,
      "WindowMinutes": 15
    },
    "ChangePassword": {
      "PermitLimit": 10,
      "WindowMinutes": 15
    }
  },
  "Email": {
    "Enabled": false,
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "CheckCertificateRevocation": true,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "Smart Solar",
      "AllowInsecureTransport": false
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Cors": {
  "AllowedOrigins": []
}
}
