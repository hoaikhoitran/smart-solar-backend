{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "SmartSolar",
    "Audience": "SmartSolar"
  },
  "Auth": {
    "EmailVerification": {
      "LifetimeMinutes": 1440
    }
  },
  "Frontend": {
    "EmailVerificationUrl": ""
  },
  "RateLimiting": {
    "Register": {
      "PermitLimit": 5,
      "WindowMinutes": 10
    },
    "VerifyEmail": {
      "PermitLimit": 20,
      "WindowMinutes": 10
    },
    "ResendVerification": {
      "PermitLimit": 3,
      "WindowMinutes": 15
    }
  },
  "Email": {
    "Enabled": false,
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "CheckCertificateRevocation": true,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "Smart Solar",
      "AllowInsecureTransport": false
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  }
}
